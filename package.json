{
  "name": "etradebazaar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=node",
    "test": "bun test",

    "db:generate": "prisma generate",
    "db:push": "prisma db push && bun src/db/migrate.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:seed": "bun src/db/seed.ts",

    "db:script": "bun scripts/main-script.ts",
    "db:seed:full": "bun scripts/main-script.ts seed",
    "db:backfill:platform-rbac": "bun scripts/main-script.ts backfill-platform-rbac",
    "db:backfill:seller-rbac": "bun scripts/main-script.ts backfill-seller-rbac",
    "db:reindex": "bun scripts/main-script.ts reindex-search"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/s3-request-presigner": "^3.1057.0",
    "@opensearch-project/opensearch": "^3.6.0",
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^7.0.1",
    "@prisma/client-runtime-utils": "^7.0.1",
    "@prisma/config": "^7.0.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@react-pdf/renderer": "^4.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.1.5",
    "geoip-lite": "^2.0.3",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "otplib": "^13.4.1",
    "pg": "^8.16.3",
    "pino": "^9.0.0",
    "pino-pretty": "^13.1.2",
    "prisma": "^7.0.1",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "resend": "^6.12.4",
    "sanitize-html": "^2.17.6",
    "xlsx": "^0.18.5",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "^1.3.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "^5.5.0"
  }
}